# Firebase web config, for recording visits and the private /visitors page.
# Copy this file to .env.local (kept out of git) and fill it in from:
# Firebase console → Project settings → General → Your apps → Web app → SDK setup and configuration.
# Add the same four values to your hosting's environment variables so the live site has them too.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
